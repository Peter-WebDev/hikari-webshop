# Prisma Postgres connection string (from console.prisma.io)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth (admin-inloggning med GitHub)
# Skapa en slumpad sträng, t.ex. med: npx auth@latest secret
BETTER_AUTH_SECRET=""
# Appens bas-URL (lokalt http://localhost:5173, i produktion Vercel-adressen)
BETTER_AUTH_URL="http://localhost:5173"
# Från din GitHub OAuth App (Settings > Developer settings)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Numeriskt GitHub-id för det konto som får vara admin (https://api.github.com/users/<användarnamn>)
ADMIN_GITHUB_ID=""
